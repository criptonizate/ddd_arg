# ─────────────────────────────────────────────────────────────
# Supabase — cliente (público, se expone al navegador)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ─────────────────────────────────────────────────────────────
# Supabase — servidor (NO exponer, solo backend)
# ─────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ─────────────────────────────────────────────────────────────
# Emails (Resend)
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
# Formato: "Nombre <mail@tu-dominio.com>" (si no está, usa onboarding@resend.dev)
RESEND_FROM_EMAIL=DDD ARG <pedidos@tu-dominio.com.ar>
# Admin que recibe notificaciones de pedidos / solicitudes
ADMIN_EMAIL=iarnaudojuanpablo@gmail.com

# ─────────────────────────────────────────────────────────────
# Contacto público
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=543804559909

# ─────────────────────────────────────────────────────────────
# URL base del sitio (sin trailing slash)
# Usada en emails y como fallback de siteUrl
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://dddarg.com.ar

# ─────────────────────────────────────────────────────────────
# Cron jobs (Vercel) — proteger endpoint /api/cron/*
# Generar con:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
CRON_SECRET=<64-hex-chars-sin-whitespace>

# ─────────────────────────────────────────────────────────────
# Telegram notifications (admin) — opcional, si falta se no-opea.
# 1. Crear bot con @BotFather → te da el token (formato: 1234:ABC...)
# 2. Enviar /start al bot desde tu Telegram
# 3. Obtener tu chat_id con @userinfobot
# 4. Configurar estas dos env en Vercel y en GitHub Secrets.
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<token-de-BotFather>
TELEGRAM_CHAT_ID=<chat-id-numerico>

# ─────────────────────────────────────────────────────────────
# Mercado Pago (Checkout Pro) — opcional
# 1. Crear app en https://www.mercadopago.com.ar/developers/panel
# 2. Credenciales → copiar "Access Token de producción" (APP_USR-...)
#    Para pruebas usar el "Access Token de test" (TEST-...)
# 3. Webhooks → URL = https://<dominio>/api/mp/webhook, evento "Pagos"
#    Copiar la "Clave secreta" del webhook para MP_WEBHOOK_SECRET.
# ─────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=<APP_USR-... o TEST-...>
MP_WEBHOOK_SECRET=<clave-secreta-del-webhook>
