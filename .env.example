# ─────────────────────────────────────────────────────────────
# Supabase — cliente (público, se expone al navegador)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ─────────────────────────────────────────────────────────────
# Supabase — servidor (NO exponer, solo backend)
# ─────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ─────────────────────────────────────────────────────────────
# Emails (Resend)
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
# Formato: "Nombre <mail@tu-dominio.com>" (si no está, usa onboarding@resend.dev)
RESEND_FROM_EMAIL=DDD ARG <pedidos@tu-dominio.com.ar>
# Admin que recibe notificaciones de pedidos / solicitudes
ADMIN_EMAIL=iarnaudojuanpablo@gmail.com

# ─────────────────────────────────────────────────────────────
# Contacto público
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=543804559909

# ─────────────────────────────────────────────────────────────
# URL base del sitio (sin trailing slash)
# Usada en emails y como fallback de siteUrl
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ddd-arg.vercel.app

# ─────────────────────────────────────────────────────────────
# Cron jobs (Vercel) — proteger endpoint /api/cron/*
# Generar con:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
CRON_SECRET=<64-hex-chars-sin-whitespace>
